{
  "name": "pi-document-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/app.ts",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "admin": "node --env-file-if-exists=.env --import tsx scripts/admin.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "setup:postgres": "tsx scripts/setup-postgres.ts",
    "spike:vector": "tsx scripts/vector-spike.ts",
    "generate:contracts": "tsx scripts/generate-contracts.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:ui",
    "test:contract": "tsx --test tests/contract/*.test.ts",
    "test:runtime": "tsx --test tests/runtime/*.test.ts",
    "test:protocol": "tsx --test tests/protocol/*.test.ts",
    "test:parsers": "tsx --test tests/parsers/*.test.ts",
    "test:retrieval": "tsx --test tests/retrieval/*.test.ts",
    "test:integration": "tsx --test tests/storage/*.test.ts tests/integration/*.test.ts",
    "test:a2a": "tsx --test tests/a2a/*.test.ts",
    "test:ingestion": "tsx --test tests/ingestion/*.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:faults": "tsx --test tests/faults/*.test.ts",
    "test:ops": "tsx --test tests/ops/*.test.ts",
    "spike:model": "node --env-file-if-exists=.env --import tsx scripts/model-spike.ts",
    "spike:embedding": "node --env-file-if-exists=.env --import tsx scripts/embedding-spike.ts",
    "test:e2e:live": "node --env-file-if-exists=.env --import tsx scripts/live-service.ts",
    "benchmark": "node --env-file-if-exists=.env --import tsx scripts/benchmark.ts",
    "verify:install": "tsx scripts/verify-install.ts",
    "manifest": "tsx scripts/source-manifest.ts",
    "test": "npm run typecheck && npm run test:contract && npm run test:runtime && npm run test:protocol && npm run test:parsers && npm run test:retrieval && npm run test:ingestion && npm run test:security && npm run test:a2a && npm run test:integration && npm run test:natural && npm run test:evaluation && npm run test:ops && npm run test:management",
    "test:natural": "tsx --test tests/natural/*.test.ts",
    "test:evaluation": "tsx --test tests/evaluation/*.test.ts",
    "eval:retrieval": "node --env-file-if-exists=.env --import tsx scripts/eval-retrieval.ts",
    "benchmark:indexing": "node --env-file-if-exists=.env --import tsx scripts/indexing-benchmark.ts",
    "verify:product": "tsx scripts/verify-product.ts",
    "report:acceptance": "tsx scripts/write-acceptance.ts",
    "typecheck:server": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p web/tsconfig.json",
    "build:ui": "vite build --config web/vite.config.ts",
    "dev:ui": "vite --config web/vite.config.ts",
    "predev": "npm run build:ui",
    "prestart": "npm run build:ui",
    "test:management": "tsx --test tests/management/*.test.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "busboy": "1.6.0",
    "cheerio": "1.2.0",
    "express": "5.2.1",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.57.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "17.10.0-beta.17",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
