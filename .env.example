# Copy to .env. The key is never written to evidence or Pi state.
AGENT_MODEL_PROFILE=./config/model.example.json
PI_DOCUMENT_AGENT_API_KEY=
NATURAL_MAX_MODEL_REQUESTS=8
NATURAL_MAX_TOOL_CALLS=20
NATURAL_TURN_TIMEOUT_MS=120000
NATURAL_MAX_CONCURRENT_TURNS=8
TASK_MAX_DURATION_MS=900000

# Embedding is a separate model profile; fill only after selecting the actual service.
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_MODEL_ID=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROFILE_VERSION=1
EMBEDDING_API_KEY_ENV=PI_DOCUMENT_EMBEDDING_API_KEY
PI_DOCUMENT_EMBEDDING_API_KEY=

# npm run dev creates an isolated database and a random local token automatically.
# npm start uses a dedicated external PostgreSQL database and explicit token instead.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/pi_document
# AUTH_BOOTSTRAP_TOKEN=
HOST=127.0.0.1
PORT=4328
